### =========================
### Local variables (file-only)
### =========================
@baseUrl = http://localhost:5000
@auth_token = __runtime_set__

#######################################################################
###                  User Manegement ENDPOINTS                      ###
#######################################################################

### =========================
### User Management Vars
### =========================
@email = newuser@example.com
@password = secret123
@register_email = newuser@example.com
@register_password = secret123
@register_nickname = newbie
@register_firstName = Alice
@register_lastName = Smith


### =========================
### Register a new user
### =========================
### // Endpoint has problems
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{register_email}}",
  "password": "{{register_password}}",
  "nickname": "{{register_nickname}}",
  "firstName": "{{register_firstName}}",
  "lastName": "{{register_lastName}}"
}


### =========================
### Login
### =========================
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### =========================
### Logout + clear auth token
### =========================
POST {{baseUrl}}/logout
Authorization: Bearer {{auth_token}}
> {%
  client.global.clear("auth_token");
%}

### =========================
### All Time Stats (protected)
### =========================
POST {{baseUrl}}/allTimeStats
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{}

#######################################################################
###                          ANIMALS ENDPOINTS                      ###
#######################################################################

### =========================
### Animal Endpoint Vars
### =========================
### TODO: Replace these manually
@animal_id = 1

### =========================
### Get all animals
### =========================
GET {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get animal by ID
### =========================
GET {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Create a new animal
### =========================
POST {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Lion",
  "imageUrl": "https://example.com/lion.png"
}

### =========================
### Update an existing animal
### =========================
PUT {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Tiger",
  "imageUrl": "https://example.com/tiger.png"
}

### =========================
### Delete an animal
### =========================
DELETE {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

#######################################################################
###                          COURSES ENDPOINTS                      ###
#######################################################################

### =========================
### Course Endpoint Vars
### =========================
### TODO: Replace these manually
@create_course_animal_ids = ["animal-id-1","animal-id-2"]
@update_course_animal_ids = ["animal-id-3","animal-id-4"]

# Course ID
@course_id = 1

### =========================
### Get all courses
### =========================
GET {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get course by ID
### =========================
GET {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Create a new course
### =========================
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "course": {
    "name": "Beginner Archery",
    "animalIds": {{create_course_animal_ids}}
  }
}

### =========================
### Update an existing course
### =========================
PUT {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "course": {
    "name": "Advanced Archery",
    "animalIds": {{update_course_animal_ids}}
  }
}

### =========================
### Delete a course
### =========================
DELETE {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

#######################################################################
###                          HUNTS ENDPOINTS                        ###
#######################################################################

### =========================
### Hunt Endpoint Vars
### =========================
# TODO: Replace these manually
@hunt_id = <manually-set-hunt-id>
@course_id_for_hunt = <manually-set-course-id>
@animal_id_for_hunt = <manually-set-animal-id>
@shot_count = 1
@points_scored = 5

### =========================
### Create a new hunt
### =========================
POST {{baseUrl}}/hunts
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get hunt by ID
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Join a hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/join
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Leave a hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/leave
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Set hunt scoring variant
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/shotvariant
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "variant": 1
}

### =========================
### Assign course to hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/course
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "courseId": "{{course_id_for_hunt}}"
}

### =========================
### Activate hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/activate
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Register a shot for an animal
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/animals/{{animal_id_for_hunt}}/shot/{{shot_count}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "pointsScored": {{points_scored}}
}

### =========================
### Get hunt stats
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}/stats
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get hunt user stats
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}/userstats
Content-Type: application/json
Authorization: Bearer {{auth_token}}