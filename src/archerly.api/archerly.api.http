### =========================
### Animal Endpoint Vars
### =========================
### TODO: Replace these manually
@animal_id = 1

### =========================
### Get all animals
### =========================
GET {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}
> {%
  console.log("Get all animals response:\n", response.body);
%}

### =========================
### Get animal by ID
### =========================
GET {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}
> {%
  console.log("Get animal by ID response:\n", response.body);
%}

### =========================
### Create a new animal
### =========================
POST {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Lion",
  "imageUrl": "https://example.com/lion.png"
}
> {%
  console.log("Post animal response:\n", response.body);
%}

### =========================
### Update an existing animal
### =========================
PUT {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Tiger",
  "imageUrl": "https://example.com/tiger.png"
}
> {%
  console.log("Put animal response:\n", response.body);
%}

### =========================
### Delete an animal
### =========================
DELETE {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}
> {%
  console.log("Delete animal response:\n", response.body);
%}

