### =========================
### Local variables (file-only)
### =========================
@baseUrl = http://localhost:5000
### Alice
@auth_token = __runtime_set__
### Till:
###@auth_token = __runtime_set__
### __runtime_set__

#######################################################################
###                  User Manegement ENDPOINTS                      ###
#######################################################################

### =========================
### User Management Vars
### =========================
@email = newuser1@example.com
@password = secret1234
@register_email = newuser1@example.com
@register_password = secret1234
@register_nickname = mew
@register_firstName = Till
@register_lastName = Smith

### Get full JSON database
GET {{baseUrl}}/debug/db
Accept: application/json

### =========================
### Register a new user
### =========================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{register_email}}",
  "password": "{{register_password}}",
  "nickname": "{{register_nickname}}",
  "firstName": "{{register_firstName}}",
  "lastName": "{{register_lastName}}"
}


### =========================
### Login
### =========================
### // Endpoint works
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### =========================
### Logout + clear auth token
### =========================
POST {{baseUrl}}/logout
Authorization: Bearer {{auth_token}}

### =========================
### All Time Stats (protected)
### =========================
POST {{baseUrl}}/allTimeStats
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{}

#######################################################################
###                          ANIMALS ENDPOINTS                      ###
#######################################################################

### =========================
### Animal Endpoint Vars
### =========================
### TODO: Replace these manually
@animal_id = 99c230ca-15d2-4333-b958-f5284a50f03b
@update_animal_id = 99c230ca-15d2-4333-b958-f5284a50f03b

### =========================
### Create a new animal
### =========================
### // Returns the Update Animal ID
POST {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Lion",
  "imageUrl": "https://example.com/lion.png"
}

### =========================
### Get all animals
### =========================
GET {{baseUrl}}/animals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get animal by ID
### =========================
GET {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}


### =========================
### Update an existing animal
### =========================
PUT {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Tiger",
  "imageUrl": "https://example.com/tiger.png"
}

### =========================
### Delete an animal
### =========================
DELETE {{baseUrl}}/animals/{{animal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

