### =========================
### Local variables (file-only)
### =========================
@baseUrl = http://localhost:5000
@auth_token = __runtime_set__

#######################################################################
###                  User Manegement ENDPOINTS                      ###
#######################################################################

### =========================
### User Management Vars
### =========================
@email = test@example.com
@password = secret123
@register_email = newuser@example.com
@register_password = secret123
@register_nickname = newbie
@register_firstName = Alice
@register_lastName = Smith


### =========================
### Register a new user
### =========================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{register_email}}",
  "password": "{{register_password}}",
  "nickname": "{{register_nickname}}",
  "firstName": "{{register_firstName}}",
  "lastName": "{{register_lastName}}"
}
> {%
  if (response.status !== 200) {
    console.error("Registration failed:", response.body);
  } else {
    console.log("Registration succeeded");
  }
%}


### =========================
### Login
### =========================
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}
> {%
  if (response.status !== 200) {
    throw new Error("Login failed");
  }
  client.global.set("auth_token", response.body.jwt);
%}

### =========================
### Logout + clear auth token
### =========================
POST {{baseUrl}}/logout
Authorization: Bearer {{auth_token}}
> {%
  client.global.clear("auth_token");
%}

### =========================
### All Time Stats (protected)
### =========================
POST {{baseUrl}}/allTimeStats
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{}
> {%
  if (response.status !== 200) {
    console.error("Failed to fetch all-time stats:\n", response.body);
  } else {
    console.log("All-time stats response:\n", response.body);
  }
%}

