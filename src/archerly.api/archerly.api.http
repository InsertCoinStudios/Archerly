@create_course_animal_ids = ["ab0691d8-dc2e-4c51-9b0b-898a07f8256d","b3818467-c704-4535-8315-cbcf5f0e79c6"]
@update_course_animal_ids = ["ba6494ca-21c7-4755-892b-a8ab31d78459","8f306388-5e08-49a3-850f-d4c883116045"]

# Course ID
@course_id = f9b14131-3215-49a1-baa5-f72dae7603Ae

### =========================
### Get all courses
### =========================
GET {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get course by ID
### =========================
GET {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Create a new course
### =========================
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "Course": {
    "Name": "Beginner Archery",
    "Location": "Some location",
    "Difficulty": "easy",
    "Info": "Some info",
    "Animals": [
      { "Id": "ab0691d8-dc2e-4c51-9b0b-898a07f8256d", "Name": "Lion", "ImageUrl": "https://example.com/lion.png" },
      { "Id": "b3818467-c704-4535-8315-cbcf5f0e79c6", "Name": "Penguin", "ImageUrl": "https://example.com/penguin.png" }
    ]
  }
}

### =========================
### Update an existing course
### =========================
PUT {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "Course": {
    "Name": "Beginner Archery",
    "Location": "Home",
    "Difficulty": "hard",
    "Info": "Lorem Ipsum",
    "Animals": [
      { "Id": "b3818467-c704-4535-8315-cbcf5f0e79c6", "Name": "Penguin", "ImageUrl": "https://example.com/penguin.png" },
      { "Id": "ab0691d8-dc2e-4c51-9b0b-898a07f8256d", "Name": "Lion", "ImageUrl": "https://example.com/lion.png" }
    ]
  }
}

### =========================
### Delete a course
### =========================
DELETE {{baseUrl}}/courses/{{course_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

#######################################################################
###                          HUNTS ENDPOINTS                        ###
#######################################################################

### =========================
### Hunt Endpoint Vars
### =========================
# TODO: Replace these manually
@hunt_id = AAAD
@course_id_for_hunt = f9b14131-3215-49a1-baa5-f72dae76036e
@animal_id_for_hunt = b3818467-c704-4535-8315-cbcf5f0e79c6
@shot_count = 1
@points_scored = 20

### =========================
### Create a new hunt
### =========================
POST {{baseUrl}}/hunts
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get hunt by ID
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Join a hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/join
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Leave a hunt
### =========================
// Potential Problems but maybe the get at the end can not see the info
POST {{baseUrl}}/hunts/{{hunt_id}}/leave
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Set hunt scoring variant
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/shotvariant
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "variant": 2
}

### =========================
### Assign course to hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/course
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "courseId": "{{course_id_for_hunt}}"
}

### =========================
### Activate hunt
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/activate
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Register a shot for an animal
### =========================
POST {{baseUrl}}/hunts/{{hunt_id}}/animals/{{animal_id_for_hunt}}/shot/{{shot_count}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "pointsScored": {{points_scored}}
}

### =========================
### Get hunt stats
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}/stats
Content-Type: application/json
Authorization: Bearer {{auth_token}}

### =========================
### Get hunt user stats
### =========================
GET {{baseUrl}}/hunts/{{hunt_id}}/userstats
Content-Type: application/json
Authorization: Bearer {{auth_token}}